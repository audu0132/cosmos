# SMW COSMOS Recipe Demo Environment Variables Example Template
# Copy this file to .env or .env.local and update values as needed.

# Application Settings
VITE_APP_TITLE="SMW COSMOS"
VITE_APP_SUBTITLE="Recipe module demo prototype"
VITE_APP_ENV=development

# User & Audit Defaults
VITE_DEFAULT_USER="Audumbar More"

# Factory & Calculation Defaults
VITE_DEFAULT_STOCK_MM=6000
VITE_DEFAULT_KERF_MM=0

# Backend / API Settings (for future integration)
VITE_API_BASE_URL="http://localhost:3000/api"
